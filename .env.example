# Dominio público (subdominio de Dokploy o tu propio dominio)
DOMAIN=capturechat.dokploy.com

# MySQL
MYSQL_ROOT_PASSWORD=cambia_esto_root
MYSQL_DATABASE=capturechat
MYSQL_USER=capturechat
MYSQL_PASSWORD=cambia_esto_user

# JWT (cópiala de Railway)
JWT_SECRET=cambia_esto_jwt_secreto

# CORS: dejar vacío = permitir todo (recomendado, ya que el front usa /api mismo-origen)
ALLOWED_ORIGINS=

# Backblaze B2 (copia los valores reales de Railway)
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_KEY_ID=tu_key_id
B2_APP_KEY=tu_app_key
B2_BUCKET=Jpservice-media
B2_PUBLIC_URL=https://s3.us-east-005.backblazeb2.com/Jpservice-media
